# Copie para .env e ajuste. Nenhuma chave é obrigatória para o modo determinístico.

# Provedor de LLM: "none" (determinístico), "ollama" (local) ou "gemini"
COPILOTO_LLM_PROVIDER=none

# Ollama (local, opcional)
COPILOTO_OLLAMA_BASE_URL=http://localhost:11434
COPILOTO_OLLAMA_MODEL=qwen3.5:9b

# Gemini (opcional; sujeito às cotas e condições vigentes do provedor)
# GEMINI_API_KEY=
COPILOTO_GEMINI_MODEL=gemini-2.0-flash

# Recuperação: "lexical" (sem downloads), "vector" ou "hybrid"
COPILOTO_RETRIEVAL_MODE=lexical
COPILOTO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Limites do agente
COPILOTO_MAX_TOOL_CALLS=6
COPILOTO_LLM_TIMEOUT_SECONDS=120
COPILOTO_APPROVAL_TTL_MINUTES=30

# Caminhos
COPILOTO_DB_PATH=data/synthetic/copiloto.db
COPILOTO_LOG_DIR=logs
